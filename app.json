{
  "expo": {
    "name": "SelfPhoneNG",
    "slug": "selfphoneng",
    "version": "0.0.1",
    "scheme": "selfphoneng",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "bet.dou.selfphoneng",
      "supportsTablet": true
    },
    "android": {
      "package": "bet.dou.selfphoneng",
      "adaptiveIcon": {
        "backgroundColor": "#090E21",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.WRITE_CONTACTS"],
      "intentFilters": [
        {
          "action": "DIAL",
          "data": [
            {
              "scheme": "tel"
            }
          ],
          "category": ["DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "tel"
            }
          ],
          "category": ["DEFAULT", "BROWSABLE"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "$(PRODUCT_NAME) uses the camera to scan the pairing QR code.",
          "microphonePermission": "$(PRODUCT_NAME) uses the microphone for your phone calls.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-callkit-telecom",
        {
          "microphonePermission": "$(PRODUCT_NAME) uses the microphone for your phone calls.",
          "cameraPermission": false,
          "supportsVideo": false,
          "includesCallsInRecents": true
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "$(PRODUCT_NAME) uses the microphone for your phone calls.",
          "cameraPermission": "$(PRODUCT_NAME) uses the camera to scan the pairing QR code."
        }
      ],
      "expo-audio",
      [
        "expo-contacts",
        {
          "contactsPermission": "$(PRODUCT_NAME) reads your contacts when you import them into SelfPhoneNG."
        }
      ]
    ]
  }
}

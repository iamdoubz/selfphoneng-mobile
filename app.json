{
  "expo": {
    "name": "SelfPhoneNG",
    "slug": "selfphoneng",
    "version": "0.0.1",
    "scheme": "selfphoneng",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "bet.dou.selfphoneng",
      "supportsTablet": true
    },
    "android": {
      "package": "bet.dou.selfphoneng",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "$(PRODUCT_NAME) uses the camera to scan the pairing QR code.",
          "microphonePermission": "$(PRODUCT_NAME) uses the microphone for your phone calls.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-callkit-telecom",
        {
          "microphonePermission": "$(PRODUCT_NAME) uses the microphone for your phone calls.",
          "cameraPermission": false,
          "supportsVideo": false,
          "includesCallsInRecents": true
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "$(PRODUCT_NAME) uses the microphone for your phone calls.",
          "cameraPermission": "$(PRODUCT_NAME) uses the camera to scan the pairing QR code."
        }
      ]
    ]
  }
}
